<%@ Page Language="C#" MasterPageFile="~/Site.Master" Title="Submit a Report" %>
<asp:Content ID="PageContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="cols"><div class="stack"><div><h1>Submit a Report</h1><p class="muted">Please use this form to report violations of the CampusForum community guidelines.</p></div>
 <section class="panel"><h3>&#x2691; Report Content or Post</h3><form data-demo-form="Content report submitted"><div class="field"><label>Violation Category *</label><select required><option value="">Select a category...</option><option>Harassment</option><option>Spam Post</option><option>Impersonation</option><option>Academic Dishonesty</option><option>Other</option></select></div><div class="field"><label>Direct Link to Content *</label><input type="url" placeholder="https://campusforum.edu/post/..." required/><small>Paste the URL of the specific post or comment.</small></div><div class="field"><label>Detailed Description *</label><textarea placeholder="Please describe exactly what happened and why this violates community standards..." required></textarea></div><div class="field"><label>Evidence / Screenshot (Optional)</label><input type="file" accept="image/*"/><small>Max 5MB in the design; upload storage is not connected yet.</small></div><div class="actions"><button class="primary pull-right">Submit Content Report</button></div></form></section>
 <section class="panel"><h3>&#x2691; Flag a User Profile</h3><p>Use this section if an entire account is dedicated to violating guidelines, ban evasion, or impersonation.</p><form data-demo-form="User flag submitted"><div class="field-grid"><div class="field"><label>Username to Flag *</label><input placeholder="student_username" required /></div><div class="field"><label>Reason for Flagging</label><select><option>Impersonation</option><option>Harassment</option><option>Spam</option></select></div></div><div class="actions"><button class="pull-right">Submit User Flag</button></div></form></section>
 </div><aside class="stack"><section class="panel"><h3>My Recent Reports <span class="badge">3 Active</span></h3><p class="row between">#R-492 Harassment <span class="badge yellow">Pending</span></p><p class="row between">#R-488 Spam Post <span class="badge">Review</span></p><p class="row between">#R-412 Vulgarity <span class="badge green">Resolved</span></p><a href="/Student/Report.aspx">View Full History &#x2192;</a></section><section class="panel"><h3>&#x24D8; Before You Report</h3><p>Ensure the content explicitly violates the Student Code of Conduct.</p><p>False reporting or weaponizing the report system is a violation itself.</p><p>Moderators review all reports within 24-48 business hours.</p><a href="/Common/Help.aspx">Campus support information</a></section></aside></div>

</asp:Content>
